  "patterns": [
    {
      "id": "not-just",
      "re": "\\bnot just (?:a|an|the|another|your|our)\\b[^.!?]{0,60}?\\b(?:it's|it is|but also|but)\\b|\\b(?:isn't|is not|aren't|are not) just (?:a|an|the|another)\\b|\\bmore than just\\b",
      "tier": 1,
      "fix": "Say the one thing it is, once."
    },
    {
      "id": "whether-youre",
      "re": "\\bwhether you(?:'re| are)\\b.{3,60}\\bor\\b",
      "tier": 1,
      "fix": "Pick the one reader this page is for."
    },
    {
      "id": "todays-world",
      "re": "\\bin today's (?:fast-paced|digital|ever-changing|modern|busy)\\b",
      "tier": 1,
      "fix": "Start with the reader's problem."
    },
    {
      "id": "say-goodbye",
      "re": "\\b(?:say|bid) goodbye to\\b",
      "tier": 1,
      "fix": "Name what they stop doing."
    },
    {
      "id": "future-is-here",
      "re": "\\bthe future of [\\w ]{2,30} is (?:here|now)\\b",
      "tier": 1,
      "fix": "Say what it does today."
    },
    {
      "id": "next-level",
      "re": "\\b(?:to|on) the next level\\b",
      "tier": 1,
      "fix": "Say where it goes, concretely."
    },
    {
      "id": "look-no-further",
      "re": "\\blook no further\\b",
      "tier": 1,
      "fix": "Cut it."
    },
    {
      "id": "dive-in",
      "re": "\\bdive (?:in|into|deep)\\b",
      "tier": 1,
      "fix": "Use \"start\" or \"read\"."
    },
    {
      "id": "ultimate",
      "re": "\\b(?:the|your) (?:ultimate|only) [\\w ]{2,30}(?:you'll ever need|you need)\\b",
      "tier": 1,
      "fix": "Say who it is for and what it does."
    },
    {
      "id": "everything-you-need",
      "re": "\\beverything you need to\\b",
      "tier": 2,
      "fix": "List the two or three things."
    },
    {
      "id": "triad",
      "re": "\\b(\\w+er)[,.] (\\w+er)[,.] (?:and )?(\\w+er)\\b",
      "tier": 2,
      "fix": "One adjective with a reason beats three without."
    },
    {
      "id": "imagine",
      "re": "^(?:imagine|what if you could)\\b",
      "tier": 2,
      "fix": "Show it instead of asking them to imagine it."
    },
    {
      "id": "its-time",
      "re": "\\bit's time to\\b",
      "tier": 2,
      "fix": "Cut it."
    },
    {
      "id": "introducing",
      "re": "^(?:introducing|meet)\\b",
      "tier": 3,
      "fix": "Lead with what it does."
    }
  ],
  "proof": [
    {
      "id": "user-count",
      "re": "\\b\\d[\\d,.]*\\s*(?:k|m|\\+)?\\+?\\s*(?:users|customers|teams|companies|businesses|creators|developers|downloads|members|subscribers|people)\\b"
    },
    {
      "id": "trusted-by",
      "re": "\\b(?:trusted|loved|used) by\\b"
    },
    {
      "id": "rating",
      "re": "(?:★{3,}|\\b[1-5](?:\\.\\d)?\\s*(?:/|out of)\\s*5\\b|\\b[1-5]\\.\\d stars?\\b)"
    },
    {
      "id": "number-one",
      "re": "(?:#1\\b|\\bnumber one\\b|\\baward-winning\\b)"
    },
    {
      "id": "as-seen-in",
      "re": "\\b(?:as seen (?:in|on)|featured in)\\b"
    }
  ],
  "placeholders": [
    {
      "re": "\\blorem ipsum\\b",
      "flags": "i"
    },
    {
      "re": "\\bdolor sit amet\\b",
      "flags": "i"
    },
    {
      "re": "\\bTODO\\b:?",
      "flags": ""
    },
    {
      "re": "\\bTBD\\b",
      "flags": ""
    },
    {
      "re": "\\bFIXME\\b",
      "flags": ""
    },
    {
      "re": "\\b(?:john|jane) doe\\b",
      "flags": "i"
    },
    {
      "re": "\\b(?:your|the) company name\\b|\\byour company\\b",
      "flags": "i"
    },
    {
      "re": "\\[(?:name|company|title|date|product|link|url)\\]",
      "flags": "i"
    },
    {
      "re": "\\b(?:user|name|you)@example\\.com\\b|\\bexample\\.com\\b",
      "flags": "i"
    },
    {
      "re": "\\b(?:asdf|qwerty|foo bar|test test)\\b",
      "flags": "i"
    }
  ],
